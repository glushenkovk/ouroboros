# ============================================================
# Ouroboros — Environment Variables Template
# Copy to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ============================================================

# ─── Required ────────────────────────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram user ID (get it from @userinfobot)
# The first user to write becomes the owner automatically,
# but you can pre-set it here to block others from startup.
# TELEGRAM_OWNER_ID=123456789

# Spending limit in USD (hard cap — agent stops spending above this)
TOTAL_BUDGET=50

# GitHub personal access token with repo scope
# Get it at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Your GitHub username and fork name
GITHUB_USER=your_github_username
GITHUB_REPO=ouroboros

# ─── LLM Providers ───────────────────────────────────────────
# OpenRouter API key (optional if you have Claude Max/Pro subscription)
# Free orchestration via Claude CLI if logged in with Max.
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI API key — enables web_search tool (optional)
OPENAI_API_KEY=

# Anthropic API key — NOT required for Claude Code CLI with Max subscription.
# ANTHROPIC_API_KEY=

# ─── Model Selection (optional — defaults shown) ─────────────
# OUROBOROS_MODEL=google/gemini-2.5-flash-preview-05-20
# OUROBOROS_MODEL_CODE=google/gemini-2.5-flash-preview-05-20
# OUROBOROS_MODEL_LIGHT=google/gemini-3-pro-preview
# OUROBOROS_WEBSEARCH_MODEL=gpt-4o
# OUROBOROS_MODEL_FALLBACK_LIST=anthropic/claude-sonnet-4.6,google/gemini-2.5-pro-preview,openai/gpt-4.1

# ─── Performance (optional — defaults shown) ─────────────────
# OUROBOROS_MAX_WORKERS=5
# OUROBOROS_MAX_ROUNDS=200
# OUROBOROS_BG_BUDGET_PCT=10
# OUROBOROS_WORKER_START_METHOD=fork

# ─── Optional: Local Ollama (free, private fallback) ─────────
# OLLAMA_HOST=http://192.168.1.130:11434
